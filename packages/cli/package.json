{
  "name": "@idesk/cli",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "idesk": "./dist/main.js"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js && esbuild src/probe.ts --bundle --platform=node --format=esm --outfile=dist/probe.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "@idesk/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.4",
    "esbuild": "0.28.2"
  }
}
